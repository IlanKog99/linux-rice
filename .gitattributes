# Shell configs break on CRLF. Normalise everything to LF in the repo and in the
# working tree, on every platform — this bundle is routinely edited from Windows.
* text=auto eol=lf

*.sh      text eol=lf
*.zsh     text eol=lf
*.lua     text eol=lf
*.conf    text eol=lf
*.jsonc   text eol=lf
.zshrc    text eol=lf
.zshenv   text eol=lf
.p10k.zsh text eol=lf

# PowerShell is the one exception: keep CRLF so it reads correctly on Windows.
*.ps1 text eol=crlf

*.ttf      binary
*.tar.gz   binary
*.tmTheme  text eol=lf

# Vendored snapshots shouldn't skew the language stats or clutter diffs.
fonts/**  linguist-vendored
vendor/** linguist-vendored
